    "def box_collision(particle: ParticleClass):\n",
    "    ''' botsing met wanden geeft periodieke randvoorwaarden '''\n",
    "    for i in range(2):\n",
    "        if particle.r[i] > BOX_SIZE_0 / 2:\n",
    "            particle.r[i] -= BOX_SIZE_0 \n",
    "        elif particle.r[i] < -BOX_SIZE_0 / 2:\n",
    "            particle.r[i] += BOX_SIZE_0"
