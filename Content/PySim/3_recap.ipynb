    "class ParticleClass:\n",
    "    def __init__(self, m, r, v, R):\n",
    "        self.m = m\n",
    "        self.r = np.array(r, dtype=float)\n",
    "        self.v = np.array(v, dtype=float)\n",
    "        self.R = R\n",
    "\n",
    "def take_time_step(particles, dt=0.5):  # tijdelijke grotere dt\n",
    "    for p in particles:\n",
    "        p.r += p.v * dt\n",
    "\n",
    "def handle_collisions(particles):\n",
    "    n = len(particles)\n",
    "    for i in range(n):\n",
    "        for j in range(i+1, n):\n",
    "            p1, p2 = particles[i], particles[j]\n",
    "            d = np.linalg.norm(p1.r - p2.r)\n",
    "            if d < (p1.R + p2.R):\n",
    "                v1, v2 = p1.v.copy(), p2.v.copy()\n",
    "                p1.v = v1 - (2*p2.m/(p1.m+p2.m)) * np.dot(v1-v2, p1.r-p2.r)/d**2 * (p1.r-p2.r)\n",
    "                p2.v = v2 - (2*p1.m/(p1.m+p2.m)) * np.dot(v2-v1, p2.r-p1.r)/d**2 * (p2.r-p1.r)\n",
    "                print(f\"Botst: Deeltje {i} ↔ Deeltje {j}\")\n",
    "\n",
    "\n",
    "p1 = ParticleClass(m=1.0, r=[-1.0, 0.0], v=[ 1.0, 0.0], R=0.3)\n",
    "p2 = ParticleClass(m=1.0, r=[ 1.0, 0.0], v=[-1.0, 0.0], R=0.3)\n",
    "p3 = ParticleClass(m=1.0, r=[ 0.0, 0.0], v=[ 0.0, 0.0], R=0.3)\n",
    "\n",
    "particles = [p1, p2, p3]\n",
    "\n",
    "take_time_step(particles)      \n",
    "handle_collisions(particles)\n",
    "\n",
    "for i, p in enumerate(particles):\n",
    "    print(f\"Deeltje {i}: v = {p.v}\")\n"
   ]
